# =============================================================================
# Flux — EV Management Platform · Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Get these from https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# NEXTAUTH_SECRET: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth
# Get from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Tesla Fleet API
# Apply at https://developer.tesla.com
# Configure the redirect URI in the Tesla developer dashboard to match below.
# -----------------------------------------------------------------------------
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:3000/api/tesla/callback

# -----------------------------------------------------------------------------
# Token encryption (32-byte hex)
# Generate with: openssl rand -hex 32
# Used to encrypt Tesla OAuth tokens at rest in Supabase via AES-256-GCM.
# -----------------------------------------------------------------------------
TESLA_TOKEN_ENCRYPTION_KEY=
