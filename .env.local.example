# =============================================================================
# Flux — EV Management Platform · Environment Variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Get these from https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# NEXTAUTH_SECRET: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth
# Get from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Tesla Fleet API
# Apply at https://developer.tesla.com
# Configure the redirect URI in the Tesla developer dashboard to match below.
# -----------------------------------------------------------------------------
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:3000/api/tesla/callback

# -----------------------------------------------------------------------------
# Token encryption (32-byte hex)
# Generate with: openssl rand -hex 32
# Used to encrypt Tesla OAuth tokens at rest in Supabase via AES-256-GCM.
# -----------------------------------------------------------------------------
TESLA_TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Tesla HTTP Proxy URL (optional — required for command signing on Model
# 3/Y/S/X built after 2021). See tesla-proxy/README.md for deploy steps.
# Example: https://flux-tesla-proxy.fly.dev
# -----------------------------------------------------------------------------
TESLA_PROXY_BASE_URL=

# -----------------------------------------------------------------------------
# Charging-station sources
#
# TomTom Search API — EV station category. Free tier ~2,500 req/day. Adds
# per-connector type + rated power on top of the keyless sources (Open Charge
# Map, OpenStreetMap/Overpass). Without this key the TomTom connector is a
# silent no-op, so station coverage falls back to OCM + OSM only.
# Get from https://developer.tomtom.com
# -----------------------------------------------------------------------------
TOMTOM_API_KEY=

# Open Charge Map key (optional — raises the anonymous rate limit).
# Get from https://openchargemap.org/site/profile/applications
OPEN_CHARGE_MAP_API_KEY=

# Ingest webhook secret — alternative to CRON_SECRET for manually triggering
# /api/internal/warm and /api/internal/ingest-stats. Generate: openssl rand -hex 24
INGEST_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Live integrations (optional)
# Comma-separated list of brand keys for which real API calls are enabled.
# Leave empty (default) to run everything against the mock simulator.
# Supported values: tesla, bmw, polestar, mercedes, vw, hyundai, renault
# Example: LIVE_INTEGRATIONS=tesla
# -----------------------------------------------------------------------------
LIVE_INTEGRATIONS=

# -----------------------------------------------------------------------------
# Anthropic (Claude Vision — document parsing for Cost Intelligence)
# Get from https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Cost Intelligence — Email inbound webhook
# Set a random secret and configure your email provider to send it as the
# header "x-webhook-secret" (or as a query param ?secret=...).
# Generate with: openssl rand -hex 24
#
# Provider setup (choose one):
#   Mailgun: Receiving → Create Route → Forward to:
#     https://yourapp.vercel.app/api/documents/inbound-email
#   SendGrid: Settings → Inbound Parse → Add Host/URL:
#     https://yourapp.vercel.app/api/documents/inbound-email
# -----------------------------------------------------------------------------
EMAIL_WEBHOOK_SECRET=

# Public app URL — fallback email domain when NEXT_PUBLIC_CLOUDMAILIN_ADDRESS is not set
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudmailin inbound address (get from https://app.cloudmailin.com)
# Vehicle emails will be: <local>+slug-vehicleid@cloudmailin.net
NEXT_PUBLIC_CLOUDMAILIN_ADDRESS=

# -----------------------------------------------------------------------------
# Notifications (feature-flagged — ships dark until enabled)
# Flip the flag to "true" to expose the notifications UI, API routes, and the
# poll-vehicles cron. Everything stays inert while unset/false.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=

# Cron auth — shared secret sent as "Authorization: Bearer <CRON_SECRET>".
# Used by Vercel cron jobs (poll-vehicles, warm). Generate: openssl rand -hex 24
CRON_SECRET=

# Web Push (VAPID) — generate once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: contact URL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@flux.app

# Email (Resend) — get from https://resend.com/api-keys
# RESEND_FROM must be a verified sender on your Resend domain.
RESEND_API_KEY=
RESEND_FROM=Flux <alerts@flux.app>

# WhatsApp (Twilio outbound) — reuses your Twilio account credentials.
# TWILIO_WHATSAPP_FROM defaults to the Twilio sandbox number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -----------------------------------------------------------------------------
# Upstash Redis — REQUIRED in production.
# Backs rate limiting (src/lib/rate-limit.ts) and charger tile/country
# freshness (src/lib/chargers/repository.ts). Without it, rate limiting falls
# back to per-instance memory that resets on every cold start, and every map
# read re-runs a full source ingest.
# Get from https://console.upstash.com
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Stripe — required before charging customers.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# -----------------------------------------------------------------------------
# Routing / pricing providers (optional — mock fallbacks used when unset)
# -----------------------------------------------------------------------------
OPENROUTESERVICE_API_KEY=
CHARGEPRICE_API_KEY=
TIBBER_TOKEN=

# -----------------------------------------------------------------------------
# Admin debug panel (/debug) — comma-separated e-mails allowed to open it.
# Unset means nobody qualifies and the route 404s, which is the safe default.
# -----------------------------------------------------------------------------
ADMIN_EMAILS=
